# Smart CRM AI Configuration
# Optional: Set your Google Gemini API key here for advanced LLM reasoning.
# If left empty, the built-in Smart NLP Engine will handle scoring, sentiment, and draft generation offline.
GEMINI_API_KEY=
PORT=8000
HOST=127.0.0.1

# Real email sending. For Gmail use smtp.gmail.com, port 587, and a Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# New leads automatically receive a dashboard follow-up reminder after this many days.
AUTO_FOLLOWUP_DAYS=2
